{
  "name": "gestion-scolaire",
  "private": true,
  "description": "Gestion scolaire : serveur Node.js (Fastify), application web installable (React, PWA), PostgreSQL.",
  "type": "module",
  "scripts": {
    "migrer": "pnpm --filter @gs/db migrer",
    "demo:vide": "pnpm --filter @gs/demo vide",
    "import:csv": "pnpm --filter @gs/demo import-csv",
    "demo:sauvegarde": "pnpm --filter @gs/demo sauvegarde",
    "demo:restaurer": "pnpm --filter @gs/demo restaurer",
    "demo:lancer": "pnpm --filter @gs/demo lancer",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "verifier": "pnpm -r exec tsc --noEmit",
    "web:build": "pnpm --filter @gs/web build",
    "web:dev": "pnpm --filter @gs/web dev",
    "demo:donnees": "pnpm --filter @gs/demo donnees"
  },
  "engines": {
    "node": ">=22"
  }
}
